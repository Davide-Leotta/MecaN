    "dp_w1.set_x(\"time (seconds)\")\n",
    "dp_w1.add_y(\"w1\", \"w1\")\n",
    "dp_w2 = DataPlotter()\n",
    "dp_w2.set_x(\"time (seconds)\")\n",
    "dp_w2.add_y(\"w2\", \"w2\")\n",
    "dp_w3 = DataPlotter()\n",
    "dp_w3.set_x(\"time (seconds)\")\n",
    "dp_w3.add_y(\"w3\", \"w3\")\n",
    "dp_w4 = DataPlotter()\n",
    "dp_w4.set_x(\"time (seconds)\")\n",
    "dp_w4.add_y(\"w4\", \"w4\")\n",
    "\n",
    "dds = DDS()\n",
    "dds.start()\n",
    "\n",
    "dds.subscribe([\"posX\", \"posZ\",\"velZ\",\"velX\"])\n",
    "\n",
